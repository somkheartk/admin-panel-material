# Environment Variables Template for DigitalOcean App Platform
# Copy this file to .do/env.yaml and fill in the actual values
# NOTE: .do/env.yaml should NOT be committed to version control
# 
# For GitHub Actions deployment, these values are read from GitHub Secrets:
# - PORT (defaults to "3001" if not set)
# - NODE_ENV (defaults to "production" if not set)
# - MONGODB_URI (required, no default)
#
# For manual deployment, replace the placeholder values below with actual values

envs:
  - key: PORT
    value: "${PORT:-3001}"
  - key: NODE_ENV
    value: "${NODE_ENV:-production}"
  - key: MONGODB_URI
    scope: RUN_AND_BUILD_TIME
    type: SECRET
    value: "${MONGODB_URI}"
  # Optional: Comma-separated list of allowed CORS origins
  # - key: ALLOWED_ORIGINS
  #   value: "${ALLOWED_ORIGINS}"
