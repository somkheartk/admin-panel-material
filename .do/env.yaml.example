# Environment Variables Template for DigitalOcean App Platform
# Copy this file to .do/env.yaml and fill in the actual values
# NOTE: .do/env.yaml should NOT be committed to version control

envs:
  - key: PORT
    value: "3001"
  - key: NODE_ENV
    value: production
  - key: MONGODB_URI
    scope: RUN_AND_BUILD_TIME
    type: SECRET
    value: "YOUR_MONGODB_CONNECTION_STRING"
  # Optional: Comma-separated list of allowed CORS origins
  # - key: ALLOWED_ORIGINS
  #   value: "https://yourdomain.com,https://www.yourdomain.com"
